# Copy this file to .env and fill in your own token. Never commit .env.
#
# Airtable Personal Access Token — required for the live Refresh feature.
# Create one at https://airtable.com/create/tokens with:
#   - scope: data.records:read
#   - access: the "Fundraise Data" base (apppBDKslp00CJu9n)
AIRTABLE_TOKEN=

# CoinGecko API key — OPTIONAL. The public API works with no key at all;
# a key only raises the rate limit, which shortens a Refresh that has many
# new token issuers to check. Get one at https://coingecko.com/en/developers.
# Set COINGECKO_API_PLAN=pro only for a paid Pro/Analyst key (it switches the
# request to pro-api.coingecko.com); leave it unset for a free Demo key.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# CoinMarketCap API key — OPTIONAL. When set, any company CoinGecko could not
# match is looked up on CoinMarketCap as a second opinion, and rows verified
# that way are tagged pv: "cmc-name-match" in the dataset. Without it, the
# refresh behaves exactly as it did before (CoinGecko only).
# Get one at https://pro.coinmarketcap.com/account.
COINMARKETCAP_API_KEY=

# --- Background sweep (optional) -----------------------------------------
# While `npm start` is running, the server can periodically ingest new
# Airtable companies AND re-check existing ones whose token may have gone
# live since. Status promotions are written straight into the dataset.
#
# SWEEP_INTERVAL_MINUTES  minutes between sweeps; 0 disables the scheduler.
# SWEEP_MAX_AGE_MONTHS    only re-check companies whose most recent round is
#                         within this many months (bounds the rate-limit cost).
# SWEEP_ON_START          run one sweep at startup rather than waiting.
SWEEP_INTERVAL_MINUTES=60
SWEEP_MAX_AGE_MONTHS=12
SWEEP_ON_START=false
